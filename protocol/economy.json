  "bounty": {
    "formula": "RP = min(BASE * (1 + Q + E + P) * D, CEIL)",
    "base_by_size": { "S": 60, "M": 180, "L": 450, "XL": 1000 },
    "first_try_bonus_by_attempt": [0.50, 0.20, 0.0],
    "efficiency": { "weight": 0.6, "max_ratio": 0.5 },
    "baseline_seed_mana": { "S": 20, "M": 80, "L": 250, "XL": 700 },
    "baseline_window": 20,
    "practice_bonus": { "archive": 0.10, "recommended_tools": 0.10, "rite_passed": 0.10 },
    "daily_full_count": { "S": 12, "M": 8, "L": 4, "XL": 2 },
    "diminished_multiplier": 0.5,
    "ceiling": { "min": 60, "per_mana": 20 },
    "duplicate_window_h": 24,
    "min_run_s": 30,
    "party_split": { "lead": 0.40, "members": 0.60 },
    "xp_per_rp": 1
  },

  "mana": {
    "usd_per_mana": 0.01,
    "micros_per_mana": 10000,
