  "map": {
    "size": 128,
    "ring_radii": [11, 22, 34, 48],
    "gates_per_ring": [4, 6, 8, 7],
    "home_plot": 7,
    "home_footprint": [3, 3]
  },

  "start": {
    "resources": { "food": 200, "wood": 200, "stone": 150, "gold": 100 },
    "townsfolk": 3,
    "age": 1
