    { "rank": "F", "xp": 0,     "accepted": 0 },
    { "rank": "E", "xp": 150,   "accepted": 2,   "unlocks": ["party_lead"] },
    { "rank": "D", "xp": 600,   "accepted": 6,   "first_try_rate": 0.50 },
    { "rank": "C", "xp": 1800,  "accepted": 15,  "first_try_rate": 0.60, "rites_passed": 2, "unlocks": ["command_allowlists"] },
    { "rank": "B", "xp": 4500,  "accepted": 35,  "first_try_rate": 0.65, "median_mana_at_or_under_baseline": true, "unlocks": ["free_hand"] },
    { "rank": "A", "xp": 10000, "accepted": 70,  "first_try_rate": 0.70, "party_tasks": 5, "unlocks": ["night_watch"] },
    { "rank": "S", "xp": 22000, "accepted": 120, "first_try_rate": 0.75, "age": 4 }
