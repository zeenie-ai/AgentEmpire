    "workshop":     { "name": "Workshop", "plain": "Artificer home", "footprint": [3, 3], "built_by": "agent", "cost": { "wood": 100, "stone": 60 }, "build_s": 45, "role": "artificer" },
    "observatory":  { "name": "Observatory", "plain": "Scholar home", "footprint": [3, 3], "built_by": "agent", "cost": { "wood": 80, "stone": 80 }, "build_s": 45, "role": "scholar" },
    "scriptorium":  { "name": "Scriptorium", "plain": "Scribe home", "footprint": [3, 3], "built_by": "agent", "cost": { "wood": 100, "stone": 40 }, "build_s": 40, "role": "scribe" },
    "watchhouse":   { "name": "Watchhouse", "plain": "Warden home", "footprint": [3, 3], "built_by": "agent", "cost": { "wood": 80, "stone": 100 }, "build_s": 50, "role": "warden" },
    "beacon_tower": { "name": "Beacon Tower", "plain": "Herald home", "footprint": [3, 3], "built_by": "agent", "cost": { "wood": 100, "stone": 120 }, "build_s": 55, "role": "herald" }
