## The cue's settings with every default filled in, or {} for an unknown cue.
static func get_cue(cue: String) -> Dictionary:
	var c: Variant = CUES.get(cue)
	if typeof(c) != TYPE_DICTIONARY:
		return {}
	var out: Dictionary = DEFAULTS.duplicate()
	out.merge(c as Dictionary, true)
	return out
