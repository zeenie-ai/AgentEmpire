extends RefCounted
## The mix: how loud, how often and how many of each cue may play. The files behind each cue
## (and their measured loudness) are in cue_files.gd, generated by scripts/fetch-audio.mjs.
##
## Fields (anything left out takes DEFAULTS):
##   bus       "UI" or "SFX" (music and ambience have their own players and buses)
##   lufs      how loud the cue plays with every volume slider at 1 (peak momentary loudness,
##             LUFS); the Audio autoload derives each file's gain from its measured loudness
##   vary      random volume spread, +/- dB
##   pitch     random pitch spread, +/- semitones (0 for anything tuned: bells, chimes, plucks)
##   cooldown  seconds before the cue can play again, so a busy town never machine-guns
##   voices    most copies of the cue playing at once
##   priority  0 world foley, 1 feedback, 2 notices, 3 bells and alerts; a full pool takes a
##             voice from a lower priority, never a higher one
##   steal     at the voice limit: "" drops the new sound, "oldest" restarts the oldest copy,
##             "far" replaces the copy farthest from the listener (world sounds) when it is nearer
##   duck      dB the music dips while the cue plays (the ambience dips half as much)
##   click     true for cues a button press triggers: they stand in for that press's ui_click
##   range     world sounds: farther from the listener than this (tiles), the cue is not played

## The cue names every workstream calls (Audio.play / Audio.play_at). Each must resolve to at
## least one file (tests/unit/test_audio.gd checks).
const CANONICAL := [
	# UI
	"ui_click", "ui_hover", "ui_open", "ui_close", "ui_confirm", "ui_error",
	# Commands
	"select_townsfolk", "select_agent", "select_building", "command_move", "command_gather",
	"command_build", "placement_ok", "placement_bad",
	# Town
	"build_start", "construct_hit", "build_complete", "train_complete", "summon", "need_houses",
	"chop", "gather_food", "drop_off", "wisp", "scroll_delivered",
	# Agents
	"task_sent", "task_started", "task_done", "reward", "sent_back", "task_failed", "hand_bell",
	"approval_granted", "approval_denied", "rank_up", "party_formed",
	# Alerts
	"alarm_bell", "warning_bell", "dawn_bell", "lanterns_dim", "font_dark", "rift", "smoke",
	# Ages and trade
	"research_start", "wall_rise", "age_bells", "trade",
]

